<?xml version="1.0" encoding="utf-8"?>
<!--
  Fila de un único slot de precio. Toda la celda se tiñe con el color del semáforo;
  un pequeño punto al inicio refuerza el color para la accesibilidad.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/slot_height"
    android:layout_marginTop="@dimen/space_1"
    android:layout_marginBottom="@dimen/space_1"
    android:background="@drawable/bg_slot_amber"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_4"
    android:paddingEnd="@dimen/space_4">

    <View
        android:id="@+id/slotDot"
        android:layout_width="@dimen/slot_dot"
        android:layout_height="@dimen/slot_dot"
        android:background="@drawable/bg_slot_green" />

    <TextView
        android:id="@+id/txtTimeRange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:text="00:00"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_base"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_base"
        android:textStyle="bold" />
</LinearLayout>