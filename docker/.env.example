# =============================================================================
# WattWise — environment template.
# Copy to docker/.env (NEVER commit the real one) and adjust:
#   cp docker/.env.example docker/.env
# Every value below is optional in dev — docker-compose.yml ships safe defaults.
# For production, fill the secrets section with strong values.
# =============================================================================

# ---- Database (SQL Server) ----
DB_NAME=wattwise_db
DB_USER=wattwise_user
DB_PASSWORD=ChangeMe!Strong2026    # avoid single quotes / parentheses
SA_PASSWORD=ChangeMe!Sa2026        # SQL Server SA account (>=8 chars, 3 of 4 classes)
MSSQL_PID=Developer                # Developer | Evaluation | Express | Enterprise | Standard

# ---- Backend (Spring Boot) ----
# JWT signing secret: at least 32 random characters.
JWT_SECRET=replace-with-a-64-char-random-string-!!!!-!!-!!!!-!!!!-!!!!!
SPRING_PROFILES_ACTIVE=prod
ESIOS_API_TOKEN=your-esi-os-api-token                 # optional; leave empty to disable real fetches
PRICE_FETCH_ENABLED=true
PRICE_FETCH_CRON=0 15 20 * * *
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ---- Analytics (Flask) ----
ANALYTICS_DAYS_DEFAULT=30

# ---- Observability ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe!Grafana2026