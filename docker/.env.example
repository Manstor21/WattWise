# =============================================================================
# WattWise — plantilla de entorno.
# Copia a docker/.env (NUNCA subas el real) y ajusta:
#   cp docker/.env.example docker/.env
# Cada valor siguiente es opcional en dev — docker-compose.yml trae valores seguros por defecto.
# Para producción, rellena la sección de secretos con valores fuertes.
# =============================================================================

# ---- Base de datos (SQL Server) ----
DB_NAME=wattwise_db
DB_USER=wattwise_user
DB_PASSWORD=ChangeMe!Strong2026    # evita comillas simples / paréntesis
SA_PASSWORD=ChangeMe!Sa2026        # Cuenta SA de SQL Server (>=8 caracteres, 3 de 4 clases)
MSSQL_PID=Developer                # Developer | Evaluation | Express | Enterprise | Standard

# ---- Backend (Spring Boot) ----
# Secreto de firma JWT: al menos 32 caracteres aleatorios.
JWT_SECRET=replace-with-a-64-char-random-string-!!!!-!!-!!!!-!!!!-!!!!!
SPRING_PROFILES_ACTIVE=prod
ESIOS_API_TOKEN=your-esi-os-api-token                 # opcional; déjalo vacío para desactivar las consultas reales
PRICE_FETCH_ENABLED=true
PRICE_FETCH_CRON=0 15 20 * * *
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ---- Analytics (Flask) ----
ANALYTICS_DAYS_DEFAULT=30

# ---- Observabilidad ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe!Grafana2026